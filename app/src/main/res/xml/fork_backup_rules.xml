<!--
    Fork: what an Android backup takes. Seedvault counts as a device transfer, so only
    <device-transfer> applies to it; <cloud-backup> repeats the same rules for any other backup.

    The app defaults to device-protected storage, so its data sits in the device_ domains. All of
    it is backed up: settings, learned words, clipboard history, custom layouts, colors, fonts and
    background images, and imported dictionaries. Android itself leaves out cache/ and no_backup/,
    which holds the SmolChat pairing and the translate and GIF keys.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- gesture data export, rebuilt from the database on every share -->
        <exclude domain="device_file" path="gesture_data" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="device_file" path="gesture_data" />
    </device-transfer>
</data-extraction-rules>
